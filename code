#include <Servo.h>

// Pin definitions
const int TRIG_PIN = 6;      // Ultrasonic Sensor TRIG
const int ECHO_PIN = 7;      // Ultrasonic Sensor ECHO
const int SERVO_PIN = 9;     // Servo Motor

const int DISTANCE_THRESHOLD = 10; // Distance threshold (10 cm)

Servo servo;

float duration_us;
float distance_cm;

void setup() {
  Serial.begin(9600);

  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);

  servo.attach(SERVO_PIN);
  servo.write(0);   // Initial position
}

void loop() {

  // Send a 10 µs pulse to TRIG
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(2);

  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);

  digitalWrite(TRIG_PIN, LOW);

  // Read the echo time
  duration_us = pulseIn(ECHO_PIN, HIGH);

  // Calculate distance in cm
  distance_cm = duration_us * 0.017;

  // Servo control
  if (distance_cm <= DISTANCE_THRESHOLD) {
    servo.write(90);   // Object detected within 10 cm
  } else {
    servo.write(0);    // Object farther than 10 cm
  }

  // Display distance
  Serial.print("Distance: ");
  Serial.print(distance_cm);
  Serial.println(" cm");

  delay(200);
}
